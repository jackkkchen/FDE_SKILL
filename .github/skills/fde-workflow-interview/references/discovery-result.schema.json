{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jackkkchen/FDE_SKILL/discovery-result.schema.json",
  "title": "FDE Workflow Discovery Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_version",
    "session",
    "participant",
    "workflow",
    "as_is_steps",
    "roles",
    "systems",
    "data_sources",
    "business_rules",
    "exceptions",
    "pain_points",
    "root_causes",
    "baseline_metrics",
    "to_be",
    "opportunities",
    "human_gates",
    "evidence",
    "material_requests",
    "open_questions",
    "review"
  ],
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^E[0-9]{3,}$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "claim": {
      "type": "object",
      "required": ["description", "evidence_ids"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "skill_version": { "type": "string", "minLength": 1 },
    "session": {
      "type": "object",
      "required": ["id", "date", "language", "question_count", "duration_target_minutes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "question_count": { "type": "integer", "minimum": 0 },
        "duration_target_minutes": { "type": "integer", "const": 20 }
      },
      "additionalProperties": false
    },
    "participant": {
      "type": "object",
      "required": ["identity_mode", "name", "role", "team"],
      "properties": {
        "identity_mode": { "enum": ["real", "alias", "withheld"] },
        "name": { "type": ["string", "null"] },
        "role": { "type": "string", "minLength": 1 },
        "team": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["name", "scope", "trigger", "inputs", "outputs", "downstream_decisions", "evidence_ids"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "required": ["start", "end", "in_scope", "out_of_scope"],
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" },
            "in_scope": { "type": "array", "items": { "type": "string" } },
            "out_of_scope": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "trigger": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "downstream_decisions": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      },
      "additionalProperties": false
    },
    "as_is_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "actor", "action", "system", "input", "output", "time", "wait", "gate", "evidence_ids"],
        "properties": {
          "step_id": { "type": "string", "pattern": "^S[0-9]{2,}$" },
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "system": { "type": "string" },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "time": { "type": "string" },
          "wait": { "type": "string" },
          "gate": { "type": "string" },
          "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
        },
        "additionalProperties": false
      }
    },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "systems": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "data_sources": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "business_rules": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "pain_points": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "root_causes": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "baseline_metrics": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "to_be": {
      "type": "object",
      "required": ["desired_outcome", "target_flow", "success_signals", "evidence_ids"],
      "properties": {
        "desired_outcome": { "type": "string" },
        "target_flow": { "type": "array", "items": { "type": "string" } },
        "success_signals": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      },
      "additionalProperties": false
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description", "evidence_ids"],
        "properties": {
          "type": { "enum": ["process-governance", "rule-automation", "data-product", "ai-assisted"] },
          "description": { "type": "string" },
          "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
        },
        "additionalProperties": false
      }
    },
    "human_gates": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "status", "source", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^E[0-9]{3,}$" },
          "claim": { "type": "string" },
          "status": { "enum": ["Reported", "Estimated", "Documented", "Assumption", "Open", "Contradicted"] },
          "source": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "material_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suggested_filename", "purpose", "likely_owner", "sensitivity_note", "evidence_ids"],
        "properties": {
          "suggested_filename": { "type": "string" },
          "purpose": { "type": "string" },
          "likely_owner": { "type": "string" },
          "sensitivity_note": { "type": "string" },
          "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
        },
        "additionalProperties": false
      }
    },
    "open_questions": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "review": {
      "type": "object",
      "required": ["status", "reviewed_at", "participant_corrections"],
      "properties": {
        "status": { "enum": ["draft", "approved_by_participant"] },
        "reviewed_at": { "type": ["string", "null"] },
        "participant_corrections": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
